# VPT / STEVE-1 Bridge Configuration
# Window title of the Minecraft game client
MINECRAFT_WINDOW_TITLE=Minecraft
# Target frame rate (Minecraft runs at 20 ticks/sec)
TARGET_FPS=20
# Input resolution for VPT model (width, height)
VPT_INPUT_WIDTH=128
VPT_INPUT_HEIGHT=128
# Device to run neural inference (cuda or cpu)
DEVICE=cpu
# Optional paths to pretrained weights
VPT_WEIGHTS_PATH=
STEVE1_WEIGHTS_PATH=
MINECLIP_WEIGHTS_PATH=
