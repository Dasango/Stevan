# Minecraft Server Connection Configuration
# Server hostname or IP (default: localhost)
MC_HOST=localhost
# Server port (default: 25565)
MC_PORT=25565
# Bot player name (offline) or Microsoft account email (microsoft)
MC_USERNAME=StevanBot
# Authentication mode: offline or microsoft (default: offline)
MC_AUTH=offline
# Minecraft version (optional, auto-negotiated if omitted)
MC_VERSION=

# Prismarine Web Viewer Configuration
# Local port for prismarine-viewer (default: 3000)
VIEWER_PORT=3000
