# LLM Provider Configuration (OpenRouter / OpenAI / Ollama / Local vLLM)
# OpenRouter API Key (leave empty or mock for local Ollama)
OPENROUTER_API_KEY=
# LLM Endpoint Base URL (default: OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Primary model identifier
LLM_PRIMARY_MODEL=google/gemini-2.0-flash-exp:free
# Comma-separated fallback models in order of priority
LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free,openrouter/free
# Model temperature (low for deterministic function calls)
LLM_TEMPERATURE=0.1
